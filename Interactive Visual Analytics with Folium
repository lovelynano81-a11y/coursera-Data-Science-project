# Create a marker with distance to a closest city, railway, highway, etc.
# Draw a line between the marker to the launch site
def add_distance_line(map_obj, launch_lat, launch_lon, target_lat, target_lon):
    # Calculate distance
    distance = calculate_distance(launch_lat, launch_lon, target_lat, target_lon)
    
    # Create marker displaying the distance
    marker = folium.Marker(
        [target_lat, target_lon],
        icon=DivIcon(
            icon_size=(20, 20),
            icon_anchor=(0, 0),
            html='<div style="font-size: 12; color:#d35400;"><b>{:10.2f} KM</b></div>'.format(distance),
        )
    )
    map_obj.add_child(marker)
    
    # Draw connecting line
    line = folium.PolyLine(
        locations=[[launch_lat, launch_lon], [target_lat, target_lon]],
        weight=1
    )
    map_obj.add_child(line)
